<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Everything this app talks to is https: the local asset loader, Google Apps
         Script and (optionally) GitHub Pages. Plain http is refused everywhere. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
